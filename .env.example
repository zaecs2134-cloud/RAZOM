# For a classroom demo, SQLite runs without installing PostgreSQL.
DATABASE_URL=sqlite:///./volunteer.db
# Production-like PostgreSQL connection example:
# DATABASE_URL=postgresql+psycopg://volunteer:strong_password@localhost:5432/volunteer
# Generate a unique value: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:3000
# Optional. Leave empty to disable Telegram notifications.
TELEGRAM_BOT_TOKEN=
